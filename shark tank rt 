    </svg>
    <h1>Shark Tank RT</h1>
    <div class="hright">
      <select id="lang" class="langsel"></select>
      <div class="acct">
        <button type="button" class="chip" id="acct-btn" aria-expanded="false" aria-controls="acct-panel"><span class="dot" aria-hidden="true"></span><span id="acct-label"></span></button>
        <div class="acct-panel" id="acct-panel" role="dialog" aria-labelledby="acct-title" hidden>
          <h3 id="acct-title" data-i="acctTitle"></h3>
          <p class="hint" id="acct-note"></p>
          <form id="acct-form" autocomplete="off">
            <label class="fl" for="acct-email" data-i="acctEmailL"></label>
            <input type="email" id="acct-email" inputmode="email" autocapitalize="off" data-ip="acctEmailP">
            <div class="row">
              <button type="submit" class="btn primary" id="acct-save" data-i="acctSave"></button>
              <button type="button" class="btn" id="acct-out" data-i="acctOut" hidden></button>
            </div>
            <div class="note err" id="acct-err" hidden></div>
          </form>
          <div class="fl-title" data-i="histL"></div>
          <ul class="hist" id="hist"></ul>
        </div>
      </div>
    </div>
  </header>
  <p class="lede" data-i="lede"></p>

  <section class="hall" id="hall" role="group" aria-label="Shark Tank">
    <div class="sign">SHARK TANK RT</div>
    <ul class="seats" id="seats"></ul>
    <div class="floor"><span class="spot" id="spot"></span></div>
  </section>

